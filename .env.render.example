# ─────────────────────────────────────────────────────────────────────────────
# Render deployment values. This is NOT loaded by the app — Render Blueprints
# don't accept an env file upload for secrets. Copy this, fill in real values,
# and paste each "sync: false" var into the Render dashboard for the
# `arbiterai` service (Environment tab) when it asks during Blueprint setup.
#
# Everything NOT marked "manual" below is already set by render.yaml and
# needs no action here.
# ─────────────────────────────────────────────────────────────────────────────

# ---------- Set automatically by render.yaml / Render — do not set manually ----------
# NODE_ENV=production
# SERVE_WEB=true
# DATABASE_URL=<wired to the arbiterai-db managed Postgres instance>
# DATABASE_SSL=false
# APP_SECRET=<Render generates a random value>
# PUBLIC_WEB_URL=<defaults to Render's RENDER_EXTERNAL_URL>
# LLM_MODE=groq
# GROQ_MODEL=llama-3.3-70b-versatile
# PAYPAL_MODE=sandbox
# ESCROW_MODE=capture_then_payout
# GITHUB_MODE=live
# POLICY_DISPUTE_WINDOW_SECONDS=45

# ---------- MANUAL: paste these into the Render dashboard ----------

# console.groq.com -> API Keys
GROQ_API_KEY=

# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# developer.paypal.com -> your app -> Webhooks -> Add Webhook
# URL to register: https://<your-service>.onrender.com/api/webhooks/paypal
# Subscribe to: Checkout order approved; Payment capture completed/denied/refunded;
# Payment authorization created/voided; all Payouts batch/item events.
PAYPAL_WEBHOOK_ID=

# developer.paypal.com -> Testing Tools -> Sandbox Accounts -> a Personal account
# used as the contractor; payouts go here. Must be a real sandbox account email
# or payouts land UNCLAIMED.
PAYPAL_PAYOUT_RECEIVER_EMAIL=

# Read-only fine-grained GitHub PAT (github.com/settings/tokens -> fine-grained)
GITHUB_TOKEN=
