# ─────────────────────────────────────────────────────────────────────────────
# ArbiterAI configuration. Copy to .env (`make env`). Everything runs in mock
# mode with zero keys; fill in credentials to switch to real services.
# ─────────────────────────────────────────────────────────────────────────────

# ---------- Core ----------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of the web app. PayPal redirects here after checkout.
# Dev: the Vite server. Docker: http://localhost:8080. Render: leave empty (uses RENDER_EXTERNAL_URL).
PUBLIC_WEB_URL=http://localhost:5173
# Origins allowed by CORS (only needed when the frontend is served from another origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Serve frontend/dist from the API (true in Docker/Render, false for `make dev`).
SERVE_WEB=false

# ---------- Database ----------
# Empty → SQLite at SQLITE_PATH (zero config). Set a postgres:// URL to use Postgres.
DATABASE_URL=
DATABASE_SSL=false
SQLITE_PATH=./data/arbiter.sqlite

# ---------- Secrets ----------
# Signs policy release grants and simulated webhooks. Generate: openssl rand -hex 32
APP_SECRET=change-me-dev-only-secret-0123456789abcdef

# ---------- LLM (Groq) ----------
# mock | groq
LLM_MODE=mock
GROQ_API_KEY=
# Any Groq chat model with JSON mode + tool calling. See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# Optional cost accounting in USD per 1M tokens (0 = log tokens only). Check Groq pricing.
LLM_COST_PER_1M_INPUT=0
LLM_COST_PER_1M_OUTPUT=0

# ---------- PayPal ----------
# mock | sandbox
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from developer.paypal.com → your app → Webhooks (needed to verify signatures).
PAYPAL_WEBHOOK_ID=
# Sandbox account that receives contractor payouts (a sandbox personal/business email).
PAYPAL_PAYOUT_RECEIVER_EMAIL=
PAYPAL_BRAND_NAME=ArbiterAI
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# capture_then_payout (default, fully implemented) | authorize_then_capture
ESCROW_MODE=capture_then_payout
# Simulator only: delay before a mock payout settles.
MOCK_PAYOUT_DELAY_MS=2500

# ---------- GitHub ----------
# mock | live. PRs under arbiterai-demo/* always resolve to local fixtures.
GITHUB_MODE=mock
GITHUB_TOKEN=

# ---------- Policy defaults (USD for money values) ----------
POLICY_MIN_CONFIDENCE=0.85
POLICY_MAX_AUTO_RELEASE=1500
POLICY_DAILY_PAYOUT_CAP=5000
POLICY_HUMAN_APPROVAL_ABOVE=2000
POLICY_DISPUTE_WINDOW_SECONDS=45

# ---------- Scheduler ----------
SCHEDULER_INTERVAL_MS=3000

# ---------- Frontend (Vite) ----------
# Leave empty when the API is same-origin (dev proxy, Docker, Render).
VITE_API_URL=
